{
  "name": "staff-commission-calculator",
  "version": "1.0.0",
  "description": "Monthly staff commission calculator — pulls Shopify orders, computes tiered bonuses, emails Amber via Resend",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "run-now": "ts-node src/index.ts --run-now",
    "setup-token": "ts-node scripts/setup-token.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "resend": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/node-cron": "^3.0.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
