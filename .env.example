# ─── Shopify ─────────────────────────────────────────────────────────────────
# Your Shopify store URL (without https://)
# e.g. my-store.myshopify.com
SHOPIFY_STORE_URL=your-store.myshopify.com

# Admin API Access Token
# Create a Custom App in Shopify Admin → Settings → Apps and sales channels
# → Develop apps → Create an app → Configure Admin API scopes → read_orders
# Then install the app to get the access token.
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Resend ──────────────────────────────────────────────────────────────────
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Email ───────────────────────────────────────────────────────────────────
# Sender address — must be a verified domain in your Resend account
EMAIL_FROM=reports@yourdomain.com

# Recipient — Amber's email address
EMAIL_TO=amber@yourdomain.com
